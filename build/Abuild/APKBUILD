pkgname=xz
pkgver=5.8.1
pkgrel=2
pkgdesc="Library and CLI tools for XZ and LZMA compressed files"
url="https://tukaani.org/xz/"
arch="all"
license="GPL-2.0-or-later AND 0BSD AND LicenseRef-scancode-public-domain AND LGPL-2.1-or-later"
#options="!check"
depends_dev="$pkgname=$pkgver-r$pkgrel"
subpackages="$pkgname-static $pkgname-dev $pkgname-doc $pkgname-libs"
source="https://github.com/tukaani-project/xz/releases/download/v$pkgver/xz-$pkgver.tar.xz
	fix-qnx.patch
"

prepare() {
	default_prepare
}

build() {
	# compression utility
	CFLAGS="$CFLAGS -O3" \
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--sysconfdir=/etc \
		--mandir=/usr/share/man \
		--infodir=/usr/share/info \
		--localstatedir=/var \
		--without-libintl-prefix \
		--without-libiconv-prefix \
		--disable-rpath \
		--disable-werror \
		--disable-doc

	sed -i \
		-e 's|^hardcode_libdir_flag_spec=.*|hardcode_libdir_flag_spec=""|g' \
		-e 's|^runpath_var=LD_RUN_PATH|runpath_var=DIE_RPATH_DIE|g' \
		libtool
	make
}

check() {
	LD_LIBRARY_PATH="$(pwd)/src/liblzma/.libs" make check || {
		cat tests/test-suite.log
		return 1
	}
}

package() {
	depends="xz-libs"
	make DESTDIR="$pkgdir" install
}

